      }
    },
    "When the notch is closed, the cats in the room sit beside it, two on each side. The black area widens to fit them.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노치를 닫았을 때 방에 있는 고양이가 노치 양옆에 2마리씩 앉습니다. 그만큼 검은 영역이 넓어집니다."
          }
        }
      }
    },
